{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shazhou-ww/repoledger/raw/refs/heads/main/schema/v2.json",
  "title": "repoledger storage contracts v2",
  "$defs": {
    "branch": {
      "type": "string",
      "pattern": "^(?!-)(?!/)(?!@$)(?!refs/)(?!remotes/)(?!.*\\.\\.)(?!.*@\\{)(?!.*[ ~^:?*\\[\\\\])(?!.*(?:^|/)\\.)(?!.*(?:^|/)[^/]*\\.lock(?:/|$))(?!.*//$)(?!.*//)(?!.*\\.$)(?!.*\/$).+$"
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?:[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?|\\[[0-9a-f:.]+\\])(?::(?!443(?:/|$))[0-9]+)?/(?!/)(?!.*//)(?!.*\\\\)(?!.*(?:/\\.{1,2})(?:/|$))(?!.*%(?:2[eEfF]|5[cC]))(?!.*[?#])[^/](?:.*[^/])?$"
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?:[a-z]{2,3}|[a-z]{5,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[0-9a-wy-z](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$",
      "description": "Canonical BCP 47 language tag; runtime validation additionally enforces Intl canonical form."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "taskRecord": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "sourceBranch",
            "createdAt",
            "updatedAt"
          ],
          "properties": {
            "state": {
              "const": "ongoing"
            },
            "sourceRepository": {
              "$ref": "#/$defs/repository"
            },
            "sourceBranch": {
              "$ref": "#/$defs/branch"
            },
            "createdAt": {
              "$ref": "#/$defs/timestamp"
            },
            "updatedAt": {
              "$ref": "#/$defs/timestamp"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "createdAt",
            "updatedAt"
          ],
          "properties": {
            "state": {
              "enum": [
                "backlog",
                "completed",
                "abandoned"
              ]
            },
            "createdAt": {
              "$ref": "#/$defs/timestamp"
            },
            "updatedAt": {
              "$ref": "#/$defs/timestamp"
            }
          }
        }
      ]
    },
    "statusFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "tasks"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "tasks": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/taskRecord"
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tasksDirectory",
    "primaryRepository",
    "primaryBranch"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "tasksDirectory": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.$)(?!.*//)(?!.*\/$).+$"
    },
    "taskLanguage": {
      "$ref": "#/$defs/language"
    },
    "primaryRepository": {
      "$ref": "#/$defs/repository"
    },
    "primaryBranch": {
      "$ref": "#/$defs/branch"
    }
  }
}