{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shazhou-ww/silvermoon/raw/refs/heads/main/schema/v1/config.schema.json",
  "title": "Silvermoon repository configuration v1",
  "description": "The repository-owned .silvermoon/config.yaml contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "primaryRepository",
    "primaryBranch"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "primaryRepository": {
      "$ref": "definitions.schema.json#/$defs/repository"
    },
    "primaryBranch": {
      "$ref": "definitions.schema.json#/$defs/branch"
    },
    "preferredLanguage": {
      "$ref": "definitions.schema.json#/$defs/languageTag"
    }
  }
}
