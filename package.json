{
  "name": "silvermoon",
  "version": "0.0.1",
  "description": "The project spirit that checks repository state and answers what's next.",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "bin": {
    "silvermoon": "bin/silvermoon.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "assets/silvermoon.svg",
    "bin",
    "src",
    "README.md",
    "schema"
  ],
  "scripts": {
    "check": "node --check bin/silvermoon.js && node --test && npm run pack:check && npm run smoke:pack && npm run check:skills",
    "check:skills": "npx skills add . --list",
    "pack:check": "node scripts/check-pack.js",
    "prepare:npm-release": "node scripts/prepare-npm-release.mjs",
    "smoke:pack": "node scripts/smoke-pack.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "agent-skills",
    "cli",
    "project-state",
    "repository",
    "validation",
    "whats-next"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/silvermoon.git"
  },
  "devDependencies": {
    "semver": "^7.8.5"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "marked": "^18.0.13",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "yaml": "^2.9.1"
  }
}
