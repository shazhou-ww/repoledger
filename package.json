{
  "name": "silvermoon",
  "version": "0.0.3",
  "description": "The project spirit that checks repository state and answers what's next.",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "bin": {
    "silvermoon": "bin/silvermoon.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "assets",
    "bin",
    "docs",
    "skills/silvermoon",
    "src",
    "README.md",
    "README.zh-CN.md",
    "schema"
  ],
  "scripts": {
    "check": "npm run lint:markdown && npm run check:quick && npm run test:integration && npm run pack:check && npm run test:e2e && npm run check:skills",
    "check:quick": "node --check bin/silvermoon.js && npm test",
    "check:skills": "node scripts/sync-skills.mjs --check && npx skills add . --list",
    "lint:markdown": "markdownlint-cli2",
    "pack:check": "node scripts/check-pack.js",
    "prepare:npm-release": "node scripts/prepare-npm-release.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "test": "npm run test:unit && npm run test:contract",
    "test:contract": "node --test \"test/contract/*.test.*\"",
    "test:e2e": "node --test \"test/e2e/*.test.*\"",
    "test:integration": "node --test \"test/integration/*.test.*\"",
    "test:unit": "node --test \"test/unit/*.test.*\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "agent-skills",
    "cli",
    "project-state",
    "repository",
    "validation",
    "whats-next"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/silvermoon.git"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "markdownlint-cli2": "^0.23.3",
    "semver": "^7.8.5"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "marked": "^18.0.13",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "yaml": "^2.9.1"
  }
}
